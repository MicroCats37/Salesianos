# Django Configuration
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=*

# Database Configuration (PostgreSQL)
# Vars DB_* son las oficiales para Django. El contenedor PostgreSQL usa POSTGRES_* internamente.
# docker-compose.yml mapea: DB_NAME a POSTGRES_DB, DB_USER a POSTGRES_USER, etc.
DB_NAME=cam_db
DB_USER=cam_user
DB_PASSWORD=changeme-change-in-production
DB_HOST=db
# Puerto interno de PostgreSQL (siempre 5432 dentro del contenedor)
#DB_PORT=5432

# ---------------------------------------------------------------
# TOP-LEVEL ARCHITECTURE (Docker Compose)
# ---------------------------------------------------------------
# Proxy NGINX (puerto unico expuesto al navegador): ${PROXY_PORT:-7000}
#   - Sirve el frontend Next.js (/)
#   - Redirige /api/* al backend Django
#   - Redirige /api/auth/{refresh,logout} a Next.js (rutas propias)
#
# Internamente (no se exponen al host, todo queda detras del proxy):
#   - frontend  -> puerto 3000 (Next.js standalone)
#   - backend   -> puerto 8000 (Django + Gunicorn)
#   - scraper   -> puerto 8001 (worker de scraping SUNAT)
#   - db        -> puerto 5432 (PostgreSQL)
# ---------------------------------------------------------------

# Puerto del proxy (punto de entrada unico para el navegador)
PROXY_PORT=7000

# Si quisieras exponer los servicios individualmente al host
# (normalmente NO hace falta porque el proxy ya los enruta):
# FRONTEND_PORT=8011
# BACKEND_PORT=8010
# WORKER_PORT=8012
# DB_EXTERNAL_PORT=7002
# SCRAPER_PORT=7004

# URL publica de la API vista desde el navegador
# Debe apuntar al proxy, NO directamente al backend.
NEXT_PUBLIC_API_URL=http://localhost:7000/api
NEXT_PUBLIC_COOKIE_SECURE=false

# Scraper SUNAT - microservicio de scraping
# Se mantiene por compatibilidad: docker-compose usa service name internamente.
SCRAPER_PORT=7004
SCRAPER_URL=http://scraper:8001

# Django settings module (default: production)
# Para desarrollo local usar: config.settings.development
DJANGO_SETTINGS_MODULE=config.settings.production

# CORS - Development: allow all origins (production debe especificar origenes exactos)
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS (specific origins when CORS_ALLOW_ALL_ORIGINS=False)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email (optional, for development use console backend)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# Seguridad HTTP
# Mantener False para desarrollo local HTTP; True solo si se usa HTTPS reverse proxy.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_BROWSER_XSS_FILTER=False
SECURE_CONTENT_TYPE_NOSNIFF=False
